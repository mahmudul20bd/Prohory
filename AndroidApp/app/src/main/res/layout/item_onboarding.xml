<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"> <com.airbnb.lottie.LottieAnimationView
    android:id="@+id/lottieOnboarding"
    android:layout_width="320dp"
    android:layout_height="320dp"
    app:lottie_autoPlay="true"
    app:lottie_loop="true"
    android:layout_marginBottom="40dp"
    app:layout_constraintBottom_toTopOf="@id/cardText"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.4"/>

    <LinearLayout
        android:id="@+id/cardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="30dp"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TITLE"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:fontFamily="@font/orbitron_bold"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description..."
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:layout_gravity="center"
            android:textAlignment="center"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>