<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/bg_cyber_gradient"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="24dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/baseline_shield_24"
        app:tint="@color/electric_cyan"
        android:background="@drawable/bg_glass_card"
        android:padding="15dp"/>

    <TextView
        android:id="@+id/tvNavUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/orbitron_bold"
        android:text="Loading..."
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvNavLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Level 1 Clearance"
        android:textColor="@color/hacker_green"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"/>

</LinearLayout>