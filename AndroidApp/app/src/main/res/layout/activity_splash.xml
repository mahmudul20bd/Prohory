<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_gradient"> <com.airbnb.lottie.LottieAnimationView
    android:id="@+id/lottieSplash"
    android:layout_width="280dp"
    android:layout_height="280dp"
    app:lottie_rawRes="@raw/scan_anim"
    app:lottie_autoPlay="true"
    app:lottie_loop="true"
    app:layout_constraintBottom_toTopOf="@+id/tvBrand"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.45" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CYBER AWARE"
        android:fontFamily="@font/orbitron_bold"
        android:textColor="@color/electric_cyan"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="10dp"

        android:shadowColor="@color/electric_cyan"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="25"

        app:layout_constraintTop_toBottomOf="@id/lottieSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT-GEN THREAT INTELLIGENCE"
        android:fontFamily="@font/orbitron_bold"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POWERED BY TENSORFLOW LITE"
        android:fontFamily="sans-serif-medium"
        android:textColor="#50FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>